# Local development. Vite exposes every VITE_ value to the browser, so never put secrets here.
VITE_APP_NAME=Social Inbox
VITE_API_BASE_URL=http://127.0.0.1:8080

# Chat widget preview. Use the widget access key and chatbot UUID from your backend.
VITE_WIDGET_API_KEY=
VITE_WIDGET_CHATBOT_ID=

# true = the inbox shows sample conversations, until the backend adds message endpoints.
VITE_INBOX_USE_MOCK=true
