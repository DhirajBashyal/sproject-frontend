# Production build. Vite exposes every VITE_ value to the browser, so never put secrets here.
VITE_APP_NAME=Social Inbox
VITE_API_BASE_URL=https://app.nepaeducation.com

# Chat widget preview. Use the widget access key and chatbot UUID from your backend.
VITE_WIDGET_API_KEY=
VITE_WIDGET_CHATBOT_ID=

# WhatsApp Embedded Signup (the "Connect WhatsApp" popup). Both IDs are public.
VITE_FACEBOOK_APP_ID=1045176655235846
VITE_WHATSAPP_CONFIG_ID=4522834454604144

# Backend setting, kept here for reference only. The frontend never reads it.
# Set it in the backend env as FACEBOOK_REDIRECT_URI. This app serves that page.
# FACEBOOK_REDIRECT_URI=https://sproject-frontend.vercel.app/social-media-integration/facebook
